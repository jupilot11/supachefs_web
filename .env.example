# Laravel content API (CONTRACT.md "Env vars"). Values are never committed.
API_BASE_URL=
SITE_SERVER_SECRET=
SITE_REVALIDATE_SECRET=
SITE_PREVIEW_TOKEN=

# Public: the Turnstile site key is the only secret-adjacent value allowed here.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Dev only: 1 = read src/lib/cms/fixtures instead of the API.
CMS_FIXTURES=
# A production build refuses fixtures unless this is also 1 (the e2e config sets it).
CMS_FIXTURES_IN_PROD=
